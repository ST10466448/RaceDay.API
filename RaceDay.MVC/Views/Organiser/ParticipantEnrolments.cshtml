@model List<RaceDay.MVC.ViewModels.OrganiserEntryViewModel>

@{
    ViewData["Title"] = "Participant Enrolments";
}

<div class="container mt-4">
    <h2>Participant Enrolments</h2>
    <p class="text-muted">
        View participants who have enrolled in your events.
    </p>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No participants have enrolled in your events yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Participant</th>
                        <th>Email</th>
                        <th>Event</th>
                        <th>Category</th>
                        <th>Distance</th>
                        <th>Entry Fee</th>
                        <th>Enrolment Date</th>
                        <th>Status</th>
                        <th>Race Number</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model)
                    {
                        <tr>
                            <td>@entry.ParticipantName</td>
                            <td>@entry.ParticipantEmail</td>
                            <td>@entry.EventName</td>
                            <td>@entry.CategoryName</td>
                            <td>@entry.DistanceKM km</td>
                            <td>R @entry.EntryFee.ToString("N2")</td>
                            <td>@entry.EntryDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                            <td>@entry.EntryStatus</td>
                            <td>
                                @(entry.RaceNumber?.ToString() ?? "Not assigned")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Organiser"
       asp-action="Dashboard"
       class="btn btn-secondary">
        Back to Dashboard
    </a>
</div>