@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">

    <div class="p-5 mb-4 bg-dark text-white rounded-3">
        <h1>Welcome, @ViewBag.FullName!</h1>
        <p class="lead">
            Manage your RaceDay events and participants.
        </p>
    </div>

    <h2 class="mb-4">Organiser Dashboard</h2>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card shadow h-100">
                <div class="card-body">
                    <h5 class="card-title">Manage Events</h5>
                    <p class="card-text">
                        Create, update and manage your race events.
                    </p>
                    <a asp-controller="Organiser"
                       asp-action="ManageEvents"
                       class="btn btn-dark">
                        Manage Events
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow h-100">
                <div class="card-body">
                    <h5 class="card-title">Manage Categories</h5>
                    <p class="card-text">
                        Create race categories and manage entry fees.
                    </p>
                    <a href="#" class="btn btn-dark">
                        Manage Categories
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow h-100">
                <div class="card-body">
                    <h5 class="card-title">Participant Enrolments</h5>
                    <p class="card-text">
                        View participants registered for your events.
                    </p>
                    <a href="#" class="btn btn-dark">
                        View Enrolments
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow h-100">
                <div class="card-body">
                    <h5 class="card-title">Manage Results</h5>
                    <p class="card-text">
                        Record and publish race results.
                    </p>
                    <a href="#" class="btn btn-dark">
                        Manage Results
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>