@model List<RaceDay.MVC.ViewModels.OrganiserEntryViewModel>

@{
    ViewData["Title"] = "Record Race Result";
}

<h2>Record Race Result</h2>

<p>Enter the finishing details for a participant enrolled in one of your events.</p>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">
        @ViewBag.ErrorMessage
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        There are no participant enrolments available for recording results.
    </div>
}
else
{
    <form asp-action="CreateResult" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label for="EntryID" class="form-label">
                Participant Enrolment
            </label>

            <select name="EntryID" id="EntryID" class="form-select" required>
                <option value="">Select a participant enrolment</option>

                @foreach (var entry in Model)
                {
                    <option value="@entry.EntryID">
                        Entry #@entry.EntryID -
                        @entry.ParticipantName -
                        @entry.EventName -
                        @entry.CategoryName
                    </option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label for="FinishTime" class="form-label">
                Finish Time (HH:MM:SS)
            </label>
            <input type="text"
                   id="FinishTime"
                   name="FinishTime"
                   class="form-control"
                   placeholder="00:45:30"
                   required />
        </div>

        <div class="mb-3">
            <label for="Position" class="form-label">
                Finishing Position
            </label>
            <input type="number"
                   id="Position"
                   name="Position"
                   class="form-control"
                   min="1"
                   max="100000"
                   required />
        </div>

        <div class="mb-3">
            <label for="AveragePace" class="form-label">
                Average Pace
            </label>
            <input type="number"
                   id="AveragePace"
                   name="AveragePace"
                   class="form-control"
                   min="0.01"
                   max="1000"
                   step="0.01"
                   placeholder="5.50"
                   required />
        </div>

        <button type="submit" class="btn btn-primary">
            Save Result
        </button>

        <a asp-action="ManageResults" class="btn btn-secondary">
            Cancel
        </a>
    </form>
}