@model RaceDay.MVC.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-header bg-dark text-white text-center">
                    <h3>Join RaceDay</h3>
                    <p class="mb-0">Create your participant account</p>
                </div>

                <div class="card-body p-4">

                    <form asp-action="Register" method="post">
                        
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="FullName"
                                   class="form-label">
                                Full Name
                            </label>

                            <input asp-for="FullName"
                                   class="form-control"
                                   placeholder="Enter your full name" />

                            <span asp-validation-for="FullName"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email"
                                   class="form-label">
                                Email Address
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="Enter your email" />

                            <span asp-validation-for="Email"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password"
                                   class="form-label">
                                Password
                            </label>

                            <input asp-for="Password"
                                   class="form-control"
                                   placeholder="Create a password" />

                            <span asp-validation-for="Password"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword"
                                   class="form-label">
                                Confirm Password
                            </label>

                            <input asp-for="ConfirmPassword"
                                   class="form-control"
                                   placeholder="Confirm your password" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger"></span>
                        </div>

                        <button type="submit"
                                class="btn btn-dark w-100">
                            Create Account
                        </button>

                    </form>

                    <hr />

                    <p class="text-center mb-0">
                        Already have an account?
                        <a asp-action="Login">
                            Login here
                        </a>
                    </p>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}