@model RaceDay.MVC.ViewModels.EventDetailsViewModel

@{
    ViewData["Title"] = "Event Details";
}

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h2 class="mb-0">@Model.EventName</h2>
        </div>

        <div class="card-body p-4">
            <h5 class="text-muted mb-3">Event Information</h5>

            <p><strong>Description:</strong> @Model.Description</p>

            <p><strong>Event Type:</strong> @Model.EventType</p>

            <p>
                <strong>Date:</strong>
                @Model.EventDate.ToString("dd MMMM yyyy")
            </p>

            <p><strong>Start Time:</strong> @Model.StartTime</p>

            <p><strong>Venue:</strong> @Model.Venue</p>

            <hr />

            <a asp-controller="Participant"
               asp-action="Index"
               class="btn btn-outline-dark">
                Back to Events
            </a>
        </div>
    </div>
</div>