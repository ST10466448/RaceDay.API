@model List<RaceDay.MVC.ViewModels.CategoryViewModel>

@{
    ViewData["Title"] = "Event Categories";
}

<div class="container mt-4">
    <h2 class="mb-3">Available Categories</h2>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No categories are currently available for this event.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var category in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow h-100">
                        <div class="card-body">
                            <h5 class="card-title">
                                @category.CategoryName
                            </h5>

                            <p>
                                <strong>Distance:</strong>
                                @category.DistanceKM km
                            </p>

                            <p>
                                <strong>Entry Fee:</strong>
                                R @category.EntryFee.ToString("N2")
                            </p>

                            <p>
                                <strong>Maximum Participants:</strong>
                                @category.MaxParticipants
                            </p>
                            <form asp-controller="Participant"
                                  asp-action="Enrol"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="CategoryID"
                                       value="@category.CategoryID" />

                                <input type="hidden"
                                       name="EventID"
                                       value="@category.EventID" />

                                <input type="hidden"
                                       name="eventId"
                                       value="@category.EventID" />

                                <button type="submit" class="btn btn-success w-100">
                                    Enrol Now
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <a asp-controller="Participant"
       asp-action="Index"
       class="btn btn-outline-dark mt-4">
        Back to Events
    </a>
</div>